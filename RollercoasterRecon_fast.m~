% function for rollercoaster reconstruction
% includes:     - equidist circles w+w/o Origin
%               - hamming circles w+w/o Origin
% INPUT Notation:
% Prep.ONLINE.NoFFT_flag = 1;[iSpace Noise SettingsInfo ReadInInfo kSpace] = read_csi('---.dat',Prep);
